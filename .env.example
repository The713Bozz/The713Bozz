# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── TradingView ──────────────────────────────────────────
TV_USERNAME=your_tradingview_username
TV_PASSWORD=your_tradingview_password
TV_WEBHOOK_SECRET=pick_a_random_secret_string
TV_WEBHOOK_PORT=8765

# ── Market data (all optional) ───────────────────────────
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=

# ── Nous Research (Hermes agent, optional) ───────────────
NOUS_API_KEY=
NOUS_BASE_URL=https://inference.nousresearch.com/v1
NOUS_PROJECT=
NOUS_MODEL=Hermes-3-Llama-3.1-70B

# ── Risk kill switch ─────────────────────────────────────
# Set to "1" to halt all order placement immediately.
TRADING_HALTED=
